# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout
*.php text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.env text eol=lf
*.env.* text eol=lf

# Backend (Laravel) specific
backend/**/*.blade.php text diff=html eol=lf
backend/**/*.php text diff=php eol=lf
backend/**/*.css text diff=css eol=lf
backend/**/*.html text diff=html eol=lf
backend/**/*.md text diff=markdown eol=lf

# Frontend files (for when you add frontend later)
frontend/**/*.js text eol=lf
frontend/**/*.jsx text eol=lf
frontend/**/*.ts text eol=lf
frontend/**/*.tsx text eol=lf
frontend/**/*.css text diff=css eol=lf
frontend/**/*.scss text eol=lf
frontend/**/*.html text diff=html eol=lf
frontend/**/*.md text diff=markdown eol=lf

# Docker files
docker-compose.yml text eol=lf
docker-compose.*.yml text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
.dockerignore text eol=lf

# Denote files that are binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.jar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Laravel export ignore (for composer archives)
backend/.github export-ignore
backend/CHANGELOG.md export-ignore
backend/.styleci.yml export-ignore
backend/tests export-ignore
backend/.phpunit.cache export-ignore
backend/.phpunit.result.cache export-ignore
backend/coverage export-ignore